# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of frontends allowed to call this API
CLIENT_URL=http://localhost:8080

# ---- Database ----
# MongoDB Atlas connection string, including the database name after .net/
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
DB_URL=

# ---- Auth ----
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_NAME=Site Owner
ADMIN_EMAIL=
# bcrypt hash of the admin password - generate with: npm run hash -- "your password"
ADMIN_PASSWORD_HASH=
# Alternative to the hash: a plaintext password that `npm run seed:admin` hashes for you
# ADMIN_PASSWORD=

# ---- Email (contact form) ----
# Gmail needs an App Password, not the account password:
# 1. Turn on 2-Step Verification
# 2. Create one at https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where contact-form messages should arrive (defaults to SMTP_USER)
OWNER_RECEIVING_EMAIL=

# ---- Image uploads (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# Optional: use these DNS servers for the mongodb+srv lookup, when the system
# resolver refuses SRV records (symptom: querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1
